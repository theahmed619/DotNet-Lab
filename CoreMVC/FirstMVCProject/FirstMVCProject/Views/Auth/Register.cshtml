@using FirstMVCProject.Dto
@model UserDto




<div class="container mt-5" style="max-width: 400px;">
    <h3 class="text-center mb-3">Register</h3>
  
    <div class="text-center ">@ViewBag.Message</div>
    <form  class="border p-4 shadow-sm rounded" asp-action="RegisterUser">
       
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="Username" asp-for="Username" class="form-control"  placeholder="Enter username" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="Email" asp-for="Email" class=" form-control" placeholder="Enter email" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="Password" asp-for="Password" class=" form-control" placeholder="Enter password" required />
        </div>

        <input type="submit" class="btn btn-success w-100 mb-3" value="Submit"/>

        <div class="text-center">
            <span>Already have an account? </span>
            <a asp-action="Login" class="text-decoration-none">Login here</a>
        </div>
    </form>
</div>